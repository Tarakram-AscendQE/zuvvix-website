# Protect sensitive email config and helper files from direct web access
<FilesMatch "^(email-config\.php|aws-ses-helper\.php|\.env)">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward API requests to the Node.js backend
  RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]

  # Forward Uploads requests to the Node.js backend
  RewriteRule ^uploads/(.*)$ http://127.0.0.1:5000/uploads/$1 [P,L]

  # Standard React SPA Routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

